+// Binary evos_precompile regenerates the platform stub seccomp programs for
+// the architecture it runs on. The Go-branch checkout ships these files
+// precompiled for amd64 only, so arm64 builds outside Bazel must run this
+// (natively or under qemu-user) before compiling runsc.
+//
+// Usage: evos_precompile <gvisor source root>
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+
+	"gvisor.dev/gvisor/pkg/seccomp/precompiledseccomp"
+	kvmfilter "gvisor.dev/gvisor/pkg/sentry/platform/kvm/mmapfilter"
+	ptracefilter "gvisor.dev/gvisor/pkg/sentry/platform/ptrace/stubfilter"
+	systrapfilter "gvisor.dev/gvisor/pkg/sentry/platform/systrap/stubfilter"
+)
+
+const header = `// Copyright 2023 The gVisor Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Code generated by tools/evos_precompile for GOARCH=%s. DO NOT EDIT.
+
+package %s
+
+import (
+	"gvisor.dev/gvisor/pkg/seccomp/precompiledseccomp"
+)
+
+var (
+	// precompiledProgramNames is the sorted list of all precompiled program
+	// names. It is populated at generation time and used by ` + "`ListPrecompiled`" + `.
+	precompiledProgramNames = []string{
+%s	}
+)
+
+// PrecompilationDisabledAtBuildTime is a constant that is used to
+// indicate that precompilation was disabled at build time.
+const PrecompilationDisabledAtBuildTime = false
+
+// GetPrecompiled returns the precompiled program for the given name,
+// and whether that program name exists.
+func GetPrecompiled(programName string) (precompiledseccomp.Program, bool) {
+	switch programName {
+%s	}
+	return precompiledseccomp.Program{}, false
+}
+
+// ListPrecompiled returns a list of all registered program names.
+func ListPrecompiled() []string {
+	return append([]string(nil), precompiledProgramNames...)
+}
+`
+
+type target struct {
+	path string
+	pkg  string
+	fn   func() ([]precompiledseccomp.Program, error)
+}
+
+func main() {
+	if len(os.Args) != 2 {
+		fmt.Fprintln(os.Stderr, "usage: evos_precompile <gvisor source root>")
+		os.Exit(2)
+	}
+	root := os.Args[1]
+	targets := []target{
+		{"pkg/sentry/platform/systrap/stubfilter_precompiled.go", "systrap", systrapfilter.PrecompiledPrograms},
+		{"pkg/sentry/platform/ptrace/stubfilter_precompiled.go", "ptrace", ptracefilter.PrecompiledPrograms},
+		{"pkg/sentry/platform/kvm/mmapfilter_precompiled.go", "kvm", kvmfilter.PrecompiledPrograms},
+	}
+	for _, t := range targets {
+		programs, err := t.fn()
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "%s: %v\n", t.path, err)
+			os.Exit(1)
+		}
+		sort.Slice(programs, func(i, j int) bool { return programs[i].Name < programs[j].Name })
+		var names, cases strings.Builder
+		for _, p := range programs {
+			fmt.Fprintf(&names, "\t%q,\n", p.Name)
+			cases.WriteString(p.SwitchCase("precompiledseccomp"))
+		}
+		out := fmt.Sprintf(header, runtime.GOARCH, t.pkg, names.String(), cases.String())
+		if err := os.WriteFile(filepath.Join(root, t.path), []byte(out), 0o644); err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		fmt.Printf("%s: %d programs for %s\n", t.path, len(programs), runtime.GOARCH)
+	}
+}
