+// Package hostcompat provides fallbacks for host system calls that are
+// missing on older kernels, such as the Linux 4.9 kernel of Android 9 devices
+// (statx: 4.11, pidfd_open: 5.3, openat2: 5.6). Each helper first tries the
+// modern call and falls back only on ENOSYS, preserving its semantics.
+package hostcompat
+
+import (
+	"fmt"
+	"os"
+	"path"
+	"strings"
+	"sync/atomic"
+
+	"golang.org/x/sys/unix"
+)
+
+var (
+	noStatx   atomic.Bool
+	noOpenat2 atomic.Bool
+	noPidfd   atomic.Bool
+)
+
+// Statx behaves like unix.Statx. On kernels without statx(2) it uses
+// fstatat(2); STATX_BTIME is then not reported (as on filesystems without
+// birth times).
+func Statx(dirfd int, p string, flags int, mask int, stat *unix.Statx_t) error {
+	if !noStatx.Load() {
+		err := unix.Statx(dirfd, p, flags, mask, stat)
+		if err != unix.ENOSYS {
+			return err
+		}
+		noStatx.Store(true)
+	}
+	var st unix.Stat_t
+	if err := unix.Fstatat(dirfd, p, &st, flags&(unix.AT_EMPTY_PATH|unix.AT_SYMLINK_NOFOLLOW|unix.AT_NO_AUTOMOUNT)); err != nil {
+		return err
+	}
+	*stat = unix.Statx_t{
+		Mask:       unix.STATX_BASIC_STATS,
+		Blksize:    uint32(st.Blksize),
+		Nlink:      uint32(st.Nlink),
+		Uid:        st.Uid,
+		Gid:        st.Gid,
+		Mode:       uint16(st.Mode),
+		Ino:        st.Ino,
+		Size:       uint64(st.Size),
+		Blocks:     uint64(st.Blocks),
+		Atime:      unix.StatxTimestamp{Sec: int64(st.Atim.Sec), Nsec: uint32(st.Atim.Nsec)},
+		Ctime:      unix.StatxTimestamp{Sec: int64(st.Ctim.Sec), Nsec: uint32(st.Ctim.Nsec)},
+		Mtime:      unix.StatxTimestamp{Sec: int64(st.Mtim.Sec), Nsec: uint32(st.Mtim.Nsec)},
+		Rdev_major: unix.Major(uint64(st.Rdev)),
+		Rdev_minor: unix.Minor(uint64(st.Rdev)),
+		Dev_major:  unix.Major(uint64(st.Dev)),
+		Dev_minor:  unix.Minor(uint64(st.Dev)),
+	}
+	return nil
+}
+
+// OpenatSingle opens name (a single path component) relative to dirfd without
+// following a symlink. It is equivalent to openat2 with RESOLVE_BENEATH |
+// RESOLVE_NO_SYMLINKS | RESOLVE_NO_MAGICLINKS for such names, and is used on
+// kernels without openat2(2).
+func OpenatSingle(dirfd int, name string, flags int, mode uint32) (int, error) {
+	if name == "" || name == "." || name == ".." || strings.Contains(name, "/") {
+		return -1, fmt.Errorf("hostcompat: %q is not a single path component", name)
+	}
+	return unix.Openat(dirfd, name, flags|unix.O_NOFOLLOW, mode)
+}
+
+// Openat2Single tries openat2(2) and falls back to OpenatSingle on ENOSYS.
+func Openat2Single(dirfd int, name string, how *unix.OpenHow) (int, error) {
+	if !noOpenat2.Load() {
+		fd, err := unix.Openat2(dirfd, name, how)
+		if err != unix.ENOSYS {
+			return fd, err
+		}
+		noOpenat2.Store(true)
+	}
+	return OpenatSingle(dirfd, name, int(how.Flags), uint32(how.Mode))
+}
+
+// OpenPathNoSymlinks opens the absolute path p with O_PATH, refusing symlinks
+// in any component (openat2 RESOLVE_NO_SYMLINKS). It walks one component at a
+// time with O_NOFOLLOW on kernels without openat2(2).
+func OpenPathNoSymlinks(p string, flags int) (int, error) {
+	if !noOpenat2.Load() {
+		fd, err := unix.Openat2(unix.AT_FDCWD, p, &unix.OpenHow{Flags: uint64(flags), Resolve: unix.RESOLVE_NO_SYMLINKS})
+		if err != unix.ENOSYS {
+			return fd, err
+		}
+		noOpenat2.Store(true)
+	}
+	if !path.IsAbs(p) {
+		return -1, unix.EINVAL
+	}
+	fd, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return -1, err
+	}
+	for _, c := range strings.Split(path.Clean(p), "/") {
+		if c == "" {
+			continue
+		}
+		next, err := unix.Openat(fd, c, unix.O_PATH|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		unix.Close(fd)
+		if err != nil {
+			return -1, err
+		}
+		var st unix.Stat_t
+		if err := unix.Fstat(next, &st); err != nil {
+			unix.Close(next)
+			return -1, err
+		}
+		if st.Mode&unix.S_IFMT == unix.S_IFLNK {
+			unix.Close(next)
+			return -1, unix.ELOOP
+		}
+		fd = next
+	}
+	return fd, nil
+}
+
+// PidfdSupported reports whether pidfd_open(2) is known to work. It is
+// optimistic until a call returns ENOSYS.
+func PidfdSupported() bool { return !noPidfd.Load() }
+
+// MarkNoPidfd records that pidfd_open(2) returned ENOSYS.
+func MarkNoPidfd() { noPidfd.Store(true) }
+
+// ProcessRunning reports whether pid exists and is not a zombie, using
+// /proc (for kernels without pidfds).
+func ProcessRunning(pid int) bool {
+	b, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return false
+	}
+	// Format: pid (comm) state ...; comm may contain spaces and parentheses.
+	s := string(b)
+	i := strings.LastIndexByte(s, ')')
+	if i < 0 || i+2 >= len(s) {
+		return false
+	}
+	return s[i+2] != 'Z' && s[i+2] != 'X'
+}
