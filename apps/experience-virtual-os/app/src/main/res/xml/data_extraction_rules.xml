<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime, images and disks are large and device-specific: never back them up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
