+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <!-- About phone > Android version: title of the Experience UI release row -->
+    <string name="experience_version">Experience UI version</string>
+    <!-- Summary of the Experience UI release row. %1$s display version, %2$s build number. -->
+    <string name="experience_version_summary"><xliff:g id="version" example="Experience UI 1.0">%1$s</xliff:g> (<xliff:g id="build" example="EXP1.0.0.20261115">%2$s</xliff:g>)</string>
+</resources>
diff --git a/res/xml/firmware_version.xml b/res/xml/firmware_version.xml
index 2669fb7..eef1d35 100644
--- a/res/xml/firmware_version.xml
+++ b/res/xml/firmware_version.xml
@@ -30,6 +30,14 @@
         settings:searchable="false"
         settings:controller="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionDetailPreferenceController"/>
 
+    <!-- Experience UI version -->
+    <Preference
+        android:key="experience_version"
+        android:title="@string/experience_version"
+        android:summary="@string/summary_placeholder"
+        settings:enableCopying="true"
+        settings:controller="com.android.settings.deviceinfo.firmwareversion.ExperienceVersionPreferenceController"/>
+
     <!-- Lineage version -->
     <Preference
         android:key="lineage_version"
diff --git a/src/com/android/settings/deviceinfo/firmwareversion/ExperienceVersionPreferenceController.java b/src/com/android/settings/deviceinfo/firmwareversion/ExperienceVersionPreferenceController.java
