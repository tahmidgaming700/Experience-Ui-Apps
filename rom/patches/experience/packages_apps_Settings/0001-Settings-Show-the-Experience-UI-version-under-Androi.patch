From b280ec6ddf05879605a61a6a683147eb746e30d5 Mon Sep 17 00:00:00 2001
From: Experience Build <build@experience.invalid>
Date: Sun, 15 Nov 2026 16:29:52 +0000
Subject: [PATCH] Settings: Show the Experience UI version under Android
 version

Add an "Experience UI version" row to About phone > Android version that
reports ro.experience.display.version and ro.experience.build.number and
opens the Experience Settings About page. The row is hidden on builds
without Experience UI properties.
---
 res/values/experience_strings.xml             | 22 ++++++
 res/xml/firmware_version.xml                  |  8 ++
 ...ExperienceVersionPreferenceController.java | 76 +++++++++++++++++++
 3 files changed, 106 insertions(+)
 create mode 100644 res/values/experience_strings.xml
 create mode 100644 src/com/android/settings/deviceinfo/firmwareversion/ExperienceVersionPreferenceController.java

diff --git a/res/values/experience_strings.xml b/res/values/experience_strings.xml
new file mode 100644
index 0000000..bb1f302
--- /dev/null
+++ b/res/values/experience_strings.xml
@@ -0,0 +1,22 @@
+<?xml version="1.0" encoding="utf-8"?>
