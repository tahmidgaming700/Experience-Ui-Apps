+package com.android.settings.deviceinfo.firmwareversion;
+
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.os.SystemProperties;
+import android.text.TextUtils;
+import android.util.Log;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Shows the Experience UI release (display version and build number) in
+ * Settings > About phone > Android version. Tapping it opens the About page
+ * of Experience Settings when that app is installed.
+ */
+public class ExperienceVersionPreferenceController extends BasePreferenceController {
+
+    private static final String TAG = "ExperienceVersionCtrl";
+
+    private static final String KEY_DISPLAY_VERSION_PROP = "ro.experience.display.version";
+    private static final String KEY_BUILD_NUMBER_PROP = "ro.experience.build.number";
+    private static final String ACTION_ABOUT = "com.experience.settings.action.ABOUT";
+
+    public ExperienceVersionPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return TextUtils.isEmpty(SystemProperties.get(KEY_DISPLAY_VERSION_PROP))
+                ? UNSUPPORTED_ON_DEVICE : AVAILABLE;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        final String version = SystemProperties.get(KEY_DISPLAY_VERSION_PROP,
+                mContext.getString(R.string.unknown));
+        final String build = SystemProperties.get(KEY_BUILD_NUMBER_PROP);
+        return TextUtils.isEmpty(build) ? version
+                : mContext.getString(R.string.experience_version_summary, version, build);
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!TextUtils.equals(preference.getKey(), getPreferenceKey())) {
+            return false;
+        }
+        final Intent intent = new Intent(ACTION_ABOUT).setPackage("com.experience.settings");
+        try {
+            mContext.startActivity(intent);
+        } catch (ActivityNotFoundException e) {
+            Log.w(TAG, "Experience Settings is not installed", e);
+        }
+        return true;
+    }
+}
