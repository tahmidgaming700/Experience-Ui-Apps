# Inputs for port.sh. Both URLs must answer HTTP range requests.

DEVICE_MODEL=RMX3941

# Official realme package for RMX3941, realme UI 5.0 / Android 14,
# build RMX3941_14.1.0.240(EX01), served from realme's own download host.
BASE_URL="https://rms01.realme.net/sw/RMX3941export_11_14.1.0.240EX01_2024112401320174.zip"
# Region variant of the per-region super metadata and my_manifest in that package.
BASE_NV_ID=00011010

# ColorOS 17.0.0.105 for the OPPO Find X3 (PEDM00), a community port
# ("Ported By BT") hosted on SourceForge. The SourceForge mirror link
# expires; the stable project path is
# https://sourceforge.net/projects/coloros-port/files/ColorOS17/17.0.0.105/
DONOR_URL="${DONOR_URL:-https://downloads.sourceforge.net/project/coloros-port/ColorOS17/17.0.0.105/ota_full-PEDM00_17.0.0.105-PMA110-09291014-CN-2026-09-01-617ad5b1a9.zip}"
