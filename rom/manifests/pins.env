# Pinned inputs for a reproducible Experience UI source tree. Consumed by scripts/rom/sync.sh.
# Update deliberately, then re-run scripts/rom/check-patches.sh before committing.

# LineageOS platform manifest (lineage-18.1 is end-of-life upstream; the branch is frozen
# apart from occasional security backports, which the refreshed patches below account for).
LINEAGE_MANIFEST_URL=https://github.com/LineageOS/android.git
LINEAGE_BRANCH=lineage-18.1

# AndyCGYan GSI build helpers and patch sets (phh Treble patches + Lineage adaptation).
LBU_URL=https://github.com/AndyCGYan/lineage_build_unified
LBU_COMMIT=5ecf530ffbd5f98ade8f15c0f6b69431d9241d39
LPU_URL=https://github.com/AndyCGYan/lineage_patches_unified
LPU_COMMIT=12aa15df70eb54ae48d805a0e938c7ae69197b5a

# Lunch target and variant.
EXPERIENCE_LUNCH=lineage_experience_arm64_bvN
EXPERIENCE_VARIANT=userdebug
