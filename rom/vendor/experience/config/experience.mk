#
# Experience UI common product configuration (inherited by every Experience product).
#
include vendor/experience/config/version.mk

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# ro.build.display.id is what Settings shows as "Build number". The underlying
# fingerprint, ro.build.version.* and the Android security patch level are
# left exactly as the platform computes them.
PRODUCT_BUILD_PROP_OVERRIDES += \
    BUILD_DISPLAY_ID="$(EXPERIENCE_DISPLAY_VERSION) ($(EXPERIENCE_BUILD_NUMBER))"

# Values with spaces cannot go through PRODUCT_*_PROPERTIES (the build writes
# them word by word), so they live in experience.prop, which TARGET_SYSTEM_PROP
# appends to /system/build.prop (device/phh/treble/board-base.mk prepends its
# own system.prop to whatever the product configured).
TARGET_SYSTEM_PROP += vendor/experience/config/experience.prop

PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
    ro.experience.version=$(EXPERIENCE_VERSION) \
    ro.experience.build.number=$(EXPERIENCE_BUILD_NUMBER) \
    ro.experience.build.id=$(EXPERIENCE_BUILD_ID) \
    ro.experience.release.channel=$(EXPERIENCE_RELEASE_CHANNEL) \
    ro.experience.edition=$(EXPERIENCE_EDITION) \
    ro.experience.gsi=1 \
    ro.experience.updater.uri=https://raw.githubusercontent.com/tahmidgaming700/Experience-Ui-Apps/main/ota/experience-ui-11.json

# ---------------------------------------------------------------------------
# Experience applications (prebuilt from apps/experience-suite, re-signed with
# the platform key by the build; see vendor/experience/prebuilt/apps)
# ---------------------------------------------------------------------------
PRODUCT_PACKAGES += \
    ExperienceLauncher \
    ExperienceSettings \
    ExperienceSetupWizard \
    ExperienceDialer \
    ExperienceMessages \
    ExperienceContacts \
    ExperienceNotes \
    ExperienceClock \
    ExperienceCalendar \
    ExperienceCalculator \
    ExperienceFiles \
    ExperienceGallery \
    ExperienceCamera \
    ExperienceConverter

PRODUCT_COPY_FILES += \
    vendor/experience/permissions/privapp-permissions-experience.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/permissions/privapp-permissions-experience.xml \
    vendor/experience/permissions/default-permissions-experience.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-experience.xml \
    vendor/experience/permissions/sysconfig-experience.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/sysconfig/sysconfig-experience.xml

# ---------------------------------------------------------------------------
# Theming: Experience accent overlays plus the AOSP shape overlays that the
# Experience Settings "Style" page can switch between at runtime.
# ---------------------------------------------------------------------------
PRODUCT_PACKAGES += \
    ExperienceAccentIndigo \
    ExperienceAccentAzure \
    ExperienceAccentTeal \
    ExperienceAccentVerdant \
    ExperienceAccentAmber \
    ExperienceAccentCoral \
    ExperienceAccentRose \
    ExperienceAccentViolet \
    ExperienceAccentGraphite \
    IconShapeSquircleOverlay \
    IconShapeRoundedRectOverlay \
    IconShapePebbleOverlay \
    IconShapeTaperedRectOverlay \
    NavigationBarModeGesturalOverlay

# ---------------------------------------------------------------------------
# Boot animation, wallpapers and sounds (generated by scripts/rom/generate-assets.sh)
# ---------------------------------------------------------------------------
# LineageOS's bootanimation module uses TARGET_BOOTANIMATION when it is set.
TARGET_BOOTANIMATION := vendor/experience/bootanimation/bootanimation.zip

PRODUCT_COPY_FILES += \
    $(call find-copy-subdir-files,*.png,vendor/experience/wallpapers,$(TARGET_COPY_OUT_PRODUCT)/media/experience/wallpapers)

PRODUCT_COPY_FILES += \
    vendor/experience/sounds/ringtones/Experience_Horizon.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/ringtones/Experience_Horizon.ogg \
    vendor/experience/sounds/notifications/Experience_Bloom.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/notifications/Experience_Bloom.ogg \
    vendor/experience/sounds/alarms/Experience_Daybreak.ogg:$(TARGET_COPY_OUT_PRODUCT)/media/audio/alarms/Experience_Daybreak.ogg

# The default ringtone/notification/alarm properties are set in the product
# makefile itself: duplicate product properties keep the first definition, and
# a product's own assignments precede everything it inherits.
