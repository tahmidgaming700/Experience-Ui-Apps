<!--
    Experience UI system configuration (/system/etc/sysconfig).

    The Experience apps use a few non-SDK platform interfaces through reflection
    (IOverlayManager for accent/navigation overlays, LocalePicker, SystemProperties,
    IWindowManager display density). Platform-signed apps are already exempt from
    hidden-API enforcement on Android 11; listing them here keeps them exempt even if a
    build re-signs them with a different certificate.
-->
<config>
    <hidden-api-whitelisted-app package="com.experience.launcher" />
    <hidden-api-whitelisted-app package="com.experience.settings" />
    <hidden-api-whitelisted-app package="com.experience.setupwizard" />
    <hidden-api-whitelisted-app package="com.experience.dialer" />
</config>
